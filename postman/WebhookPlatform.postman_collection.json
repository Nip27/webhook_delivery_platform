{
  "info": {
    "name": "Webhook Delivery Platform",
    "description": "Complete API collection for the Webhook Delivery Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "api_key", "value": "" },
    { "key": "endpoint_id", "value": "" },
    { "key": "subscription_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "var json = pm.response.json();",
            "pm.collectionVariables.set('access_token', json.accessToken);"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"dev@example.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"Dev User\"\n}" }
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "var json = pm.response.json();",
            "pm.collectionVariables.set('access_token', json.accessToken);"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"dev@example.com\",\n  \"password\": \"password123\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Endpoints",
      "item": [
        {
          "name": "Create Endpoint",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "var json = pm.response.json();",
            "pm.collectionVariables.set('endpoint_id', json.id);"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/webhooks/endpoints",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"url\": \"https://webhook.site/your-unique-id\",\n  \"description\": \"Test endpoint\"\n}" }
          }
        },
        {
          "name": "List Endpoints",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/webhooks/endpoints",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Delete Endpoint",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/v1/webhooks/endpoints/{{endpoint_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Subscriptions",
      "item": [
        {
          "name": "Create Subscription",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('subscription_id', pm.response.json().id);"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/webhooks/subscriptions",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"webhookEndpointId\": \"{{endpoint_id}}\",\n  \"eventTypeName\": \"order.created\"\n}" }
          }
        },
        {
          "name": "List Subscriptions",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/webhooks/subscriptions",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "API Keys",
      "item": [
        {
          "name": "Create API Key",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('api_key', pm.response.json().key);"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/api-keys",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Production Key\"\n}" }
          }
        },
        {
          "name": "List API Keys",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/api-keys",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Publish Event (JWT)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/events/publish",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"eventType\": \"order.created\",\n  \"payload\": {\n    \"orderId\": \"ORD-123\",\n    \"amount\": 99.99,\n    \"currency\": \"USD\"\n  }\n}" }
          }
        },
        {
          "name": "Publish Event (API Key)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/events/publish",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{api_key}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"eventType\": \"order.created\",\n  \"idempotencyKey\": \"order-123-v1\",\n  \"payload\": {\n    \"orderId\": \"ORD-123\",\n    \"amount\": 99.99\n  }\n}" }
          }
        },
        {
          "name": "List Events",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/events?page=0&size=20", "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }] },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Deliveries",
      "item": [
        {
          "name": "List Delivery Logs",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/deliveries?page=0&size=20", "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }] },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/dashboard/stats",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    }
  ]
}
